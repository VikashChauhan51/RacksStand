{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Polly": {
    "RetryCount": 5,
    "DelayInMilliseconds": 100,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationInSeconds": 30
  },
  "Caching": {
    "Expiration": "00:30:00",
    "LocalCacheExpiration": "00:05:00",
    "Flags": "None"
  }
}
