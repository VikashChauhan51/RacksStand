@page "/add-shop"

@using Models
@using Microsoft.FluentUI
@using System.ComponentModel.DataAnnotations
@using RacksStand.App.Features.Shops.Services;

@inject IJSRuntime JSRuntime
@inject IShopService shopService

<FluentEditForm Model="@shopModel" @ref="shopForm" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <FluentLabel for="name">Shop Name</FluentLabel>
    <FluentTextField id="name" @bind-Value="shopModel.Name" />
    <ValidationMessage For="@(() => shopModel.Name)" class="validation-message" />


    <FluentLabel for="description">Description</FluentLabel>
    <FluentTextArea id="description" @bind-Value="shopModel.Description" rows="5"></FluentTextArea>
    <ValidationMessage For="@(() => shopModel.Description)" class="validation-message" />


    <FluentLabel for="address">Address</FluentLabel>
    <FluentTextField id="address" @bind-Value="shopModel.Address" />
    <ValidationMessage For="@(() => shopModel.Address)" class="validation-message" />
        <br/>
    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Submit</FluentButton>


</FluentEditForm>




@code {
    private ShopModel shopModel = new ShopModel();
    private FluentEditForm shopForm;

    private void HandleSubmit()
    {
        // Handle form submission logic
        Console.WriteLine("Form submitted successfully");
    }

    public class ShopModel
    {
        [Required(ErrorMessage = "Shop Name is required.")]
        public string Name { get; set; }

        [MaxLength(500, ErrorMessage = "Description must not exceed 500 characters.")]
        public string Description { get; set; }

        [Required(ErrorMessage = "Address is required.")]
        [MaxLength(300, ErrorMessage = "Address must not exceed 300 characters.")]
        public string Address { get; set; }
    }
}

